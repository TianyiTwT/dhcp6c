#!/system/bin/sh
# dhcp6c 回调脚本（Android）
#
# 契约：dhcp6c 调用该脚本时 argv 只有脚本路径本身，信息全在环境变量里。
#   $REASON                  SOLICIT / REQUEST / RENEW / REBIND / RELEASE / EXIT / NBI
#   $IFNAME                  接口名
#   $NAINFO                  形如 "IAID=0 ADDRESS=2001:... PLTIME=9000 VLIFE=14400"
#   $new_domain_name_servers 服务端下发的 DNS（本网络为空，见模块文档）
#
# 注意事项：
#   1) 地址是由 dhcp6c 自己通过 ifaddrconf() 写进内核的，**不需要脚本代劳**。
#      脚本在这里改 ip 地址只会互相打架。
#   2) 脚本必须尽快返回并 exit 0。它是在 dhcp6c 主循环之外同步执行的，
#      卡住会拖住整个客户端。

LOG=/data/adb/dhcp6c/script.log

{
	echo "---- $(date 2>/dev/null || echo '(no date)') ----"
	echo "REASON=$REASON"
	echo "IFNAME=$IFNAME"
	echo "NAINFO=$NAINFO"
	echo "new_domain_name_servers=$new_domain_name_servers"
	echo "new_domain_name=$new_domain_name"
	case "$REASON" in
	REQUEST|RENEW|REBIND|NBI)
		echo "--- 接口上的 IPv6 地址 ---"
		ip -6 addr show dev "$IFNAME" 2>&1
		echo "--- IPv6 默认路由（主表；Android 的实际路由在 per-network 表里，这里多为空）---"
		ip -6 route show default 2>&1
		;;
	esac
} >> "$LOG" 2>&1

exit 0
