# dhcp6c 客户端配置模板 —— Android / KernelSU 场景
#
# 只做一件事：在指定接口上发起 IA_NA（有状态地址分配）并索取 DNS 服务器。
# 不启用 rapid-commit，走标准四步握手（Solicit→Advertise→Request→Reply）。
#
# 用法：把 __IFNAME__ 替换成真实接口名（通常 wlan0）后安装到
#       <prefix>/dhcp6c.conf，其中 <prefix> 是 build.sh 的 --prefix（默认
#       /data/adb/dhcp6c）。
#
# ---------------------------------------------------------------------------
# 两个必须注意的点（都是实际踩过的坑）
#
# 1) DNS 那一行必须用 request，不能写 send。
#    DHCPOPT_DNS 在 config.c 的 add_options() 里只接受 DHCPOPTCODE_REQUEST；
#    写成 send 会打一行 "invalid operation (0) for option type (19)"，然后
#    **静默地**不把选项 23 加进 ORO —— 也就是根本没请求 DNS，但只有那一行
#    log 能看出来。上游自带的 dhcp6c.conf.sample 里写的正是 send，是个坑。
#
# 2) 必须带 -p 指定 pid 文件。
#    编译期 DHCP6C_PIDFILE 默认为 /var/run/dhcp6c.pid，而 Android 上没有
#    /var/run；该文件在 -f 模式下也会被无条件打开，打开失败进程直接退出。
#    因此启动命令形如：
#      dhcp6c -f -p /data/adb/dhcp6c/dhcp6c.pid -c /data/adb/dhcp6c/dhcp6c.conf
# ---------------------------------------------------------------------------

interface __IFNAME__ {
	send ia-na 0;
	request domain-name-servers;
	script "/data/adb/dhcp6c/dhcp6c-script";
};

id-assoc na {
};
